[submodule "shellrc/.config/zsh/plugins/zsh-autosuggestions"]
	path = shellrc/.config/zsh/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
	branch = master
[submodule "shellrc/.config/zsh/plugins/zsh-syntax-highlighting"]
	path = shellrc/.config/zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
	branch = master
